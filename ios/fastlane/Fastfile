require 'base64'
require 'deliver/upload_metadata'
require 'fileutils'

# Fastlane 2.238 fetches review attachments even when none are configured.
# A first App Store version has no review-detail resource yet, so Apple returns
# an empty response. Skip only that unnecessary fetch; real attachments still
# use Fastlane's original implementation.
module FirstVersionReviewAttachmentGuard
  def review_attachment_file(version)
    return unless options[:app_review_attachment_file]

    super
  end

  private :review_attachment_file
end

Deliver::UploadMetadata.prepend(FirstVersionReviewAttachmentGuard)

default_platform(:ios)

def connect_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch('ASC_API_KEY_ID'),
    issuer_id: ENV.fetch('ASC_API_ISSUER_ID'),
    key_content: ENV.fetch('ASC_API_KEY_BASE64'),
    is_key_content_base64: true,
    duration: 1200,
    in_house: false
  )
end

def build_signed_ipa(api_key)
  bundle_id = ENV.fetch('BUNDLE_ID', 'kz.onetap.app')
  repository_token = Base64.strict_encode64("x-access-token:#{ENV.fetch('MATCH_GIT_TOKEN')}")

  match(
    type: 'appstore',
    app_identifier: bundle_id,
    team_id: ENV.fetch('APPLE_TEAM_ID'),
    api_key: api_key,
    readonly: false,
    git_url: ENV.fetch('MATCH_GIT_URL'),
    git_branch: ENV.fetch('MATCH_GIT_BRANCH', 'certificates'),
    git_basic_authorization: repository_token
  )

  update_code_signing_settings(
    use_automatic_signing: false,
    path: 'Runner.xcodeproj',
    team_id: ENV.fetch('APPLE_TEAM_ID'),
    bundle_identifier: bundle_id,
    profile_name: "match AppStore #{bundle_id}",
    code_sign_identity: 'Apple Distribution'
  )

  build_number = ENV.fetch('BUILD_NUMBER', '1')
  project_root = File.expand_path('../..', __dir__)
  export_options = File.join(project_root, 'build', 'ExportOptions.generated.plist')
  FileUtils.mkdir_p(File.dirname(export_options))
  File.write(export_options, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>method</key>
      <string>app-store-connect</string>
      <key>signingStyle</key>
      <string>manual</string>
      <key>teamID</key>
      <string>#{ENV.fetch('APPLE_TEAM_ID')}</string>
      <key>signingCertificate</key>
      <string>Apple Distribution</string>
      <key>provisioningProfiles</key>
      <dict>
        <key>#{bundle_id}</key>
        <string>match AppStore #{bundle_id}</string>
      </dict>
      <key>stripSwiftSymbols</key>
      <true/>
      <key>uploadSymbols</key>
      <true/>
    </dict>
    </plist>
  PLIST
  sh("cd '#{project_root}' && flutter build ipa --release --build-number #{build_number} --export-options-plist='#{export_options}'")

  ipa = Dir[File.join(project_root, 'build', 'ios', 'ipa', '*.ipa')].first
  UI.user_error!('Flutter did not produce an IPA') unless ipa
  ipa
end

platform :ios do
  desc 'Create the OneTap.kz identifier and App Store Connect record once'
  lane :bootstrap do
    api_key = connect_api_key
    app_name = ENV.fetch('APP_NAME', 'OneTap.kz')
    app_sku = ENV.fetch('APP_SKU', 'ONETAP-KZ-IOS')
    produce(
      api_key: api_key,
      app_identifier: ENV.fetch('BUNDLE_ID', 'kz.onetap.app'),
      app_name: app_name,
      sku: app_sku,
      language: 'ru-RU',
      team_id: ENV.fetch('APPLE_TEAM_ID'),
      skip_itc: false,
      skip_devcenter: false
    )
  end

  desc 'Build, sign, and upload an internal TestFlight beta'
  lane :beta do
    setup_ci
    api_key = connect_api_key
    ipa = build_signed_ipa(api_key)

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      changelog: 'Первая внутренняя beta OneTap.kz: каталог поставщиков, прайс, общая корзина и статусы.'
    )
  end

  desc 'Upload the signed OneTap.kz public release candidate'
  lane :release_candidate do
    setup_ci
    api_key = connect_api_key
    ipa = build_signed_ipa(api_key)

    upload_to_app_store(
      api_key: api_key,
      ipa: ipa,
      app_identifier: ENV.fetch('BUNDLE_ID'),
      app_version: ENV.fetch('APP_VERSION', '0.1.0'),
      metadata_path: File.join(__dir__, 'metadata'),
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc 'Upload App Store text metadata and optional real screenshots'
  lane :upload_store_metadata do
    api_key = connect_api_key
    include_screenshots = ENV.fetch('UPLOAD_SCREENSHOTS', 'false') == 'true'

    upload_to_app_store(
      api_key: api_key,
      app_identifier: ENV.fetch('BUNDLE_ID'),
      app_version: ENV.fetch('APP_VERSION', '0.1.0'),
      metadata_path: File.join(__dir__, 'metadata'),
      screenshots_path: File.join(__dir__, 'screenshots'),
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: !include_screenshots,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc 'Submit the prepared OneTap.kz version to App Review'
  lane :submit_review do
    UI.user_error!('Brand rights must be confirmed before App Review') unless ENV.fetch('BRAND_RIGHTS_CONFIRMED', 'false') == 'true'

    api_key = connect_api_key
    upload_to_app_store(
      api_key: api_key,
      app_identifier: ENV.fetch('BUNDLE_ID'),
      app_version: ENV.fetch('APP_VERSION', '0.1.0'),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: true,
        content_rights_has_rights: true
      }
    )
  end
end
