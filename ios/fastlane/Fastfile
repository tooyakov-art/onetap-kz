require 'base64'

default_platform(:ios)

def connect_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch('ASC_API_KEY_ID'),
    issuer_id: ENV.fetch('ASC_API_ISSUER_ID'),
    key_content: ENV.fetch('ASC_API_KEY_BASE64'),
    is_key_content_base64: true,
    duration: 1200,
    in_house: false
  )
end

platform :ios do
  desc 'Create the OneClick.kz identifier and App Store Connect record once'
  lane :bootstrap do
    api_key = connect_api_key
    app_name = ENV.fetch('APP_NAME', 'OneClick.kz')
    app_sku = ENV.fetch('APP_SKU', 'ONECLICK-KZ-IOS')
    produce(
      api_key: api_key,
      app_identifier: ENV.fetch('BUNDLE_ID', 'kz.oneclick.app'),
      app_name: app_name,
      sku: app_sku,
      language: 'ru-RU',
      team_id: ENV.fetch('APPLE_TEAM_ID'),
      skip_itc: false,
      skip_devcenter: false
    )
  end

  desc 'Build, sign, and upload an internal TestFlight beta'
  lane :beta do
    setup_ci
    api_key = connect_api_key
    bundle_id = ENV.fetch('BUNDLE_ID', 'kz.oneclick.app')
    repository_token = Base64.strict_encode64("x-access-token:#{ENV.fetch('GITHUB_TOKEN')}")

    match(
      type: 'appstore',
      app_identifier: bundle_id,
      team_id: ENV.fetch('APPLE_TEAM_ID'),
      api_key: api_key,
      readonly: false,
      git_url: ENV.fetch('MATCH_GIT_URL'),
      git_branch: ENV.fetch('MATCH_GIT_BRANCH', 'certificates'),
      git_basic_authorization: repository_token
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: 'Runner.xcodeproj',
      team_id: ENV.fetch('APPLE_TEAM_ID'),
      bundle_identifier: bundle_id,
      profile_name: "match AppStore #{bundle_id}",
      code_sign_identity: 'Apple Distribution'
    )

    build_number = ENV.fetch('BUILD_NUMBER', '1')
    project_root = File.expand_path('../..', __dir__)
    export_options = File.join(project_root, 'ios', 'ExportOptions.plist')
    sh("cd '#{project_root}' && flutter build ipa --release --build-number #{build_number} --export-options-plist='#{export_options}'")

    ipa = Dir[File.join(project_root, 'build', 'ios', 'ipa', '*.ipa')].first
    UI.user_error!('Flutter did not produce an IPA') unless ipa

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      changelog: 'Первая внутренняя beta OneClick.kz: каталог поставщиков, прайс, общая корзина и статусы.'
    )
  end
end
